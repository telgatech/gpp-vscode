{
  "name": "telga-goplusplus-vscode",
  "displayName": "GPP Programming Language",
  "description": "Syntax highlighting and editor support for GPP files.",
  "version": "0.1.9",
  "publisher": "telgatech",
  "license": "BSD-3-Clause",
  "repository": {
    "type": "git",
    "url": "https://github.com/telgatech/gpp-vscode.git"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "main": "./extension.js",
  "activationEvents": [
    "onLanguage:gpp",
    "onCommand:gpp.runProject",
    "onCommand:gpp.buildProject",
    "onCommand:gpp.testProject",
    "onCommand:gpp.showOutput",
    "onCommand:gpp.organizeImports",
    "onCommand:gpp.getDiagnostics"
  ],
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "commands": [
      {
        "command": "gpp.formatDocument",
        "title": "GPP: Format Document",
        "category": "GPP"
      },
      {
        "command": "gpp.runProject",
        "title": "GPP: Run Project",
        "category": "GPP"
      },
      {
        "command": "gpp.buildProject",
        "title": "GPP: Build Project",
        "category": "GPP"
      },
      {
        "command": "gpp.testProject",
        "title": "GPP: Test Project",
        "category": "GPP"
      },
      {
        "command": "gpp.showOutput",
        "title": "GPP: Show Output",
        "category": "GPP"
      },
      {
        "command": "gpp.organizeImports",
        "title": "GPP: Organize Imports",
        "category": "GPP"
      },
      {
        "command": "gpp.getDiagnostics",
        "title": "GPP: Refresh Diagnostics",
        "category": "GPP"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "gpp.formatDocument",
          "when": "editorLangId == gpp",
          "group": "1_modification"
        }
      ]
    },
    "configurationDefaults": {
      "[gpp]": {
        "editor.defaultFormatter": "telgatech.telga-goplusplus-vscode",
        "editor.formatOnSave": true,
        "editor.inlayHints.enabled": "off",
        "editor.quickSuggestions": {
          "other": true,
          "comments": false,
          "strings": false
        },
        "editor.quickSuggestionsDelay": 50,
        "editor.suggestOnTriggerCharacters": true
      }
    },
    "languages": [
      {
        "id": "gpp",
        "aliases": [
          "GPP"
        ],
        "extensions": [
          ".gpp",
          ".gpp.tpl"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "gpp",
        "scopeName": "source.gpp",
        "path": "./syntaxes/gpp.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "GPP",
      "properties": {
        "gpp.lsp.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable the GPP language server for diagnostics and editor features."
        },
        "gpp.lsp.command": {
          "type": "string",
          "default": "~/go/bin/gpp",
          "description": "GPP executable used for the language server and document formatting."
        },
        "gpp.lsp.args": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "lsp"
          ],
          "description": "Arguments passed to the GPP language-server command."
        }
      }
    },
    "snippets": [
      {
        "language": "gpp",
        "path": "./snippets/gpp.json"
      }
    ]
  },
  "scripts": {
    "test": "node --test test/*.test.js"
  }
}
